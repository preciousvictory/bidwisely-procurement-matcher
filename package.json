{
	"name": "bidwisely-procurement-matcher",
	"version": "0.0.1",
	"type": "module",
	"description": "This is a boilerplate of an Apify Actor.",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@crawlee/cheerio": "^3.15.3",
		"apify": "^3.7.0",
		"openai": "^7.23.0"
	},
	"devDependencies": {
		"@apify/eslint-config": "^2.0.0",
		"@apify/tsconfig": "^0.2.0",
		"@types/node": "^24.0.0",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.5",
		"globals": "^17.0.0",
		"prettier": "^3.5.3",
		"tsx": "^4.20.3",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.58.0",
		"vitest": "^5.0.0"
	},
	"scripts": {
		"start": "npm run start:dev",
		"start:prod": "node dist/main.js",
		"start:dev": "node --env-file=.env --import=tsx/esm src/main.ts",
		"build": "tsc",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run"
	},
	"author": "It's not you it's me",
	"license": "ISC"
}
